# =============================================================================
# Simorgh Industrial Electrical Assistant - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# =============================================================================

# -----------------------------------------------------------------------------
# GITHUB CONTAINER REGISTRY
# -----------------------------------------------------------------------------
GITHUB_REPOSITORY_OWNER=your-github-username
IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# NEO4J - KNOWLEDGE GRAPH DATABASE
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=simorgh_secure_2024

# Neo4j Memory Settings (Optional - already set in docker-compose)
# NEO4J_HEAP_INITIAL=512m
# NEO4J_HEAP_MAX=2G
# NEO4J_PAGECACHE=512m

# -----------------------------------------------------------------------------
# REDIS - CACHING & SESSION STORE
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_CHAT_DB=1
REDIS_CACHE_DB=2
REDIS_AUTH_DB=3

# Redis Memory Limit (Optional - already set in docker-compose)
# REDIS_MAXMEMORY=512mb

# -----------------------------------------------------------------------------
# QDRANT - VECTOR DATABASE
# -----------------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333

# Qdrant Collection Settings. Dimensions default to bge-m3 (1024) under
# QDRANT_HYBRID=1. Set to 768 if you keep the legacy all-MiniLM-L6-v2
# or all-mpnet-base-v2 dense encoder.
QDRANT_COLLECTION_SIZE=1024
QDRANT_DISTANCE_METRIC=cosine

# Hybrid retrieval: dense (bge-m3, multilingual incl. Persian) + sparse
# (BM25 via fastembed) with native Qdrant Query API RRF fusion, then a
# bge-reranker-v2-m3 cross-encoder rerank. The legacy single-dense path
# only embedded English well and missed identifiers (part numbers, IEC
# clauses, OE codes). When QDRANT_HYBRID=1, qdrant_service routes
# writes / reads through services/qdrant_hybrid.
#
# Existing dense-only collections MUST be migrated before the hybrid
# path can read them — the migration deletes and re-creates the
# collection with the named-vector schema, then re-embeds every chunk:
#   docker compose exec -T project-agent-service \\
#     python3 /app/scripts/migrate_qdrant_hybrid.py            # dry-run
#   docker compose exec -T project-agent-service \\
#     python3 /app/scripts/migrate_qdrant_hybrid.py --apply
QDRANT_HYBRID=1
QDRANT_SPARSE_MODEL=Qdrant/bm25
QDRANT_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
QDRANT_RERANK=1
QDRANT_PREFETCH_DENSE=60
QDRANT_PREFETCH_SPARSE=60
QDRANT_FUSE_TOP_K=30

# context-search-service /search/content cross-encoder reranker (Phase 7).
# ES handles cross-source retrieval (BM25 + kNN over the simorgh-content
# index covering project docs, GitLab, TPMS, tech-kb, emails). Adding a
# cross-encoder pass over the fused top-30 hits before returning top-K
# catches "relevant entity, wrong context" misorderings the embedding
# retriever can't see. Falls back to ES ordering on any encoder failure
# so /search/content never regresses below today's behaviour.
CONTENT_SEARCH_RERANK=1
CONTENT_SEARCH_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CONTENT_SEARCH_RERANK_PREFETCH=30

# -----------------------------------------------------------------------------
# COCOINDEX - DATA FRAMEWORK
# -----------------------------------------------------------------------------
COCOINDEX_URL=http://cocoindex:8080
COCOINDEX_DB_PASSWORD=cocoindex_2024

# CocoIndex PostgreSQL
COCOINDEX_DATABASE_URL=postgresql://cocoindex:cocoindex_2024@cocoindex_db:5432/cocoindex

# -----------------------------------------------------------------------------
# MYSQL - EXTERNAL AUTHENTICATION (READ-ONLY)
# -----------------------------------------------------------------------------
# Can also use SQL_SERVER_* for backward compatibility
MYSQL_HOST=your_mysql_server_ip_or_hostname
MYSQL_PORT=3306
MYSQL_USER=readonly_user
MYSQL_PASSWORD=your_readonly_password
MYSQL_DATABASE=your_database_name

# Example:
# MYSQL_HOST=192.168.1.148
# MYSQL_PORT=3306
# MYSQL_USER=technical
# MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=projects

# -----------------------------------------------------------------------------
# LLM CONFIGURATION - HYBRID SUPPORT
# -----------------------------------------------------------------------------

# OpenAI API (Online Mode)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
# Alternative models: gpt-4-turbo, gpt-3.5-turbo

# Local LLM cluster (Offline Mode)
#  192.168.1.61 → qwen3-30b-a3b (text LLM, 4-bit AWQ, vllm/vllm-openai)
#  192.168.1.62 → qwen2.5-vl-7b (VLM, served by vllm/vllm-openai)
#
# Legacy chat-service consumes the /ai shape via the load-balanced
# llm_servers upstream (.61 only — .62 is no longer a drop-in second
# text node). Keep LOCAL_LLM_URL_1 pointed at .61.
LOCAL_LLM_URL_1=http://192.168.1.61/ai
LOCAL_LLM_URL_2=http://192.168.1.61/ai

# Newer llm-gateway service speaks OpenAI /v1 to both boxes and
# auto-routes image-bearing requests to the VLM. Configured via:
LOCAL_LLM_URL_TEXT=http://192.168.1.61/v1
# Qwen3-30B-A3B-Instruct-2507 (4-bit AWQ) served on .61 with
# --tool-call-parser hermes. Must match --served-model-name on .61.
LOCAL_LLM_MODEL_TEXT=qwen3-30b-a3b
LOCAL_LLM_URL_VLM=http://192.168.1.62/v1
LOCAL_LLM_MODEL_VLM=qwen2.5-vl-7b
# Same value on both boxes if you set one
LOCAL_LLM_API_KEY=
# Harmony response sanitiser in llm-gateway. 0 = off (Qwen3, default);
# set 1 ONLY if you roll the offline text model back to gpt-oss-20b.
OFFLINE_TEXT_HARMONY=0

# Default LLM Mode (online, offline, auto)
DEFAULT_LLM_MODE=online

# --- Legacy techserver (SMB host, read via techserver-mcp) ------------------
# Each engineering project is a top-level SMB share named after its OE folder
# (OE12065, OE11071-Sunlight…). techserver-mcp lists the tree + fetches single
# files on demand (Drawing/ CAD excluded). EKC\tech is the proven login.
TECHSERVER_HOST=192.168.1.3
TECHSERVER_USER=EKC\tech
TECHSERVER_PASSWORD=
# Optional: split domain explicitly instead of EKC\tech form.
TECHSERVER_DOMAIN=
# Hard exclusions — never list/fetch these (CAD + archives are huge).
TECHSERVER_EXCLUDE_DIRS=Drawing
TECHSERVER_EXCLUDE_EXTS=.dwg,.dxf,.ema,.edb,.elk,.dwl,.bak,.7z,.rar,.zip

# LLM Settings
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_CACHE_TTL=3600

# -----------------------------------------------------------------------------
# OPT-IN STANDARD-IMAGE SWAPS (Pattern A flags + Pattern C shim)
# See simorgh-agent/docs/opt-in-services-runbook.md for the per-service
# build / deploy / verify / rollback procedure. Every flag defaults to 0
# (legacy path), so this file remains safe to copy as-is.
# -----------------------------------------------------------------------------

# LiteLLM proxy in front of vLLM (.61/.62). When USE_LITELLM=1, llm-gateway
# rewrites every backend's base_url to LITELLM_URL; model names and routing
# logic stay in llm-gateway. Roll back instantly: USE_LITELLM=0 + restart.
USE_LITELLM=0
LITELLM_URL=http://litellm:4000
LITELLM_MASTER_KEY=

# Docling (IBM) PDF/DOCX/PPTX → Markdown. When USE_DOCLING=1, doc-processor
# routes extraction through docling-serve; on any failure (timeout, empty
# result, network) it silently falls back to the local pdfplumber+EasyOCR
# pipeline. Requires building simorgh-docling:offline once on a host with
# internet egress (see docling/Dockerfile) or pre-populating the
# simorgh_docling_models volume via the docling-models-fetch workflow.
USE_DOCLING=1
DOCLING_URL=http://docling-serve:5001
DOCLING_TIMEOUT_SEC=180

# Whole-document spec extraction. When SOFT_WHOLE_DOC=1 (default), the
# uploads source-kind extractor sees the FULL document markdown and
# uses vLLM's guided_json + a two-pass verification loop against the
# local gpt-oss-20b. The legacy window-based path silently truncated
# at 16K chars, losing pages 3+ of any 27-page spec. Disable with
# SOFT_WHOLE_DOC=0 if you need to roll back; the regex pre-pass is
# unaffected either way.
SOFT_WHOLE_DOC=1
SOFT_WHOLE_DOC_MAX_CHARS=200000
SOFT_WHOLE_DOC_TIMEOUT_SEC=180
SOFT_WHOLE_DOC_MAX_TOKENS=4000
SOFT_WHOLE_DOC_TEMPERATURE=1.0

# Document relevance gate — filters obviously-irrelevant uploads
# (inventory spreadsheets, invoices, purchase orders, drawings) BEFORE
# the heavy extractor sees them. Stage 1 is filename heuristics
# (matches موجودی / inventory / invoice / SLD etc.); stage 2 is a
# cheap LLM triage for ambiguous filenames. Failures default to
# "proceed", so a gateway hiccup never blocks a legitimate spec.
SOFT_DOC_RELEVANCE_GATE=1
SOFT_DOC_RELEVANCE_MIN_CONF=0.7
SOFT_DOC_RELEVANCE_TIMEOUT_SEC=30

# Docker-image-tag-style projectName when posting to simorgh-soft.
# When SOFT_PROJECT_TAGGING=1 (default), each Design Suite project is
# created with projectName = <chatbot-project>:<user>-<YYYYMMDD-HHMM>,
# and the LLM-extracted human-readable name is preserved in
# projectDescription. Set to 0 to use the verbatim extracted name
# (legacy behaviour).
SOFT_PROJECT_TAGGING=1

# SearXNG privacy metasearch. When USE_SEARXNG=1, search-service routes
# web_search through SearXNG; on any failure silently falls back to the
# legacy DuckDuckGo wrapper. CAVEAT: NOT air-gap safe — SearXNG queries
# google.com / bing.com / wikipedia.org on your behalf and needs outbound
# HTTPS. SEARXNG_SECRET must be a random string (any value works locally);
# generate with: openssl rand -hex 32.
USE_SEARXNG=0
SEARXNG_URL=http://searxng:8080
SEARXNG_TIMEOUT_SEC=20
SEARXNG_SECRET=CHANGE-ME-openssl-rand-hex-32

# -----------------------------------------------------------------------------
# EMBEDDING MODEL
# -----------------------------------------------------------------------------
# bge-m3 is the default for the hybrid path (multilingual, 1024d). Set
# back to sentence-transformers/all-mpnet-base-v2 (768d) only when
# QDRANT_HYBRID=0.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=768

# -----------------------------------------------------------------------------
# BACKEND API SETTINGS
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8890
BACKEND_WORKERS=4

# API Settings
API_TIMEOUT=600
MAX_UPLOAD_SIZE=104857600  # 100MB in bytes

# -----------------------------------------------------------------------------
# FRONTEND SETTINGS
# -----------------------------------------------------------------------------
VITE_API_URL=/api
VITE_API_BASE=/api
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
CHOKIDAR_USEPOLLING=true

# -----------------------------------------------------------------------------
# AUTHORIZATION CACHING
# -----------------------------------------------------------------------------
AUTH_CACHE_TTL=3600  # 1 hour in seconds

# -----------------------------------------------------------------------------
# CHAT HISTORY SETTINGS
# -----------------------------------------------------------------------------
CHAT_HISTORY_MAX_MESSAGES=100
CHAT_HISTORY_TTL=86400  # 24 hours

# -----------------------------------------------------------------------------
# FILE UPLOAD SETTINGS
# -----------------------------------------------------------------------------
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=100  # MB
ALLOWED_EXTENSIONS=.pdf,.docx,.xlsx,.txt,.csv

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

# -----------------------------------------------------------------------------
# TIMEZONE
# -----------------------------------------------------------------------------
TZ=Asia/Tehran

# -----------------------------------------------------------------------------
# POSTGRESQL - MODERN AUTHENTICATION DATABASE
# -----------------------------------------------------------------------------
POSTGRES_AUTH_HOST=postgres_auth
POSTGRES_AUTH_PORT=5432
POSTGRES_AUTH_DATABASE=simorgh_auth
POSTGRES_AUTH_USER=simorgh
POSTGRES_AUTH_PASSWORD=simorgh_secure_2024
POSTGRES_MIN_CONNECTIONS=2
POSTGRES_MAX_CONNECTIONS=20

# -----------------------------------------------------------------------------
# POSTGRESQL + APACHE AGE - GRAPH DATABASE (CoT graph_search)
# Stood up by compose/infra-postgres-age.yml. Empty AGE_DSN keeps
# graph_search dormant; set it to enable the property-graph retriever.
# -----------------------------------------------------------------------------
POSTGRES_AGE_USER=simorgh_graph
POSTGRES_AGE_PASSWORD=simorgh_graph_2024
POSTGRES_AGE_DATABASE=simorgh_graph
POSTGRES_AGE_HTTP_PORT=5434
# Pinned because apache/age has no `latest` for a specific PG major.
POSTGRES_AGE_IMAGE_TAG=release_PG16_1.6.0
AGE_DSN=postgresql://simorgh_graph:simorgh_graph_2024@postgres_age:5432/simorgh_graph
AGE_GRAPH_NAME=simorgh

# -----------------------------------------------------------------------------
# SECURITY & JWT AUTHENTICATION
# -----------------------------------------------------------------------------
# IMPORTANT: Change this in production!
JWT_SECRET_KEY=your-secret-key-change-in-production-use-random-256bit
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60  # 1 hour for access tokens
REFRESH_TOKEN_EXPIRE_DAYS=30    # 30 days for refresh tokens

# Rate Limiting
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# -----------------------------------------------------------------------------
# GOOGLE OAUTH 2.0
# -----------------------------------------------------------------------------
# Setup instructions:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create OAuth 2.0 Client ID (Web application)
#   3. Add Authorized JavaScript origins:
#      - https://simorghai.electrokavir.com
#   4. Add Authorized redirect URIs:
#      - https://simorghai.electrokavir.com/chatbot/auth/google/callback
#   5. Copy Client ID and Client Secret here
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://simorghai.electrokavir.com/chatbot/auth/google/callback

# -----------------------------------------------------------------------------
# EMAIL SERVICE
# -----------------------------------------------------------------------------
# For Gmail SMTP:
#   1. Go to https://myaccount.google.com/apppasswords
#   2. Generate an App Password (requires 2FA enabled)
#   3. Use your Gmail address as SMTP_USER
#   4. Use the generated App Password as SMTP_PASSWORD
EMAIL_PROVIDER=smtp  # smtp, sendgrid
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_USE_TLS=true
FROM_EMAIL=noreply@simorgh.ai
FROM_NAME=Simorgh AI

# SendGrid (alternative to SMTP)
# SENDGRID_API_KEY=SG.your-sendgrid-api-key

# Frontend URL (for email verification/reset links - must match your deployed URL)
FRONTEND_URL=https://simorghai.electrokavir.com/chatbot

# Cookie settings (true for HTTPS production deployments)
SECURE_COOKIES=true
COOKIE_DOMAIN=.electrokavir.com

# -----------------------------------------------------------------------------
# CORS SETTINGS (Optional)
# -----------------------------------------------------------------------------
# CORS_ORIGINS=http://localhost:5173,http://192.168.1.68
# CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# MONITORING (Optional)
# -----------------------------------------------------------------------------
# ENABLE_METRICS=true
# METRICS_PORT=9090

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
ENABLE_GRAPH_RAG=true
ENABLE_DOCUMENT_PROCESSING=true
ENABLE_SQL_AUTH=true
ENABLE_REDIS_CACHE=true

# -----------------------------------------------------------------------------
# DEVELOPMENT SETTINGS (Optional)
# -----------------------------------------------------------------------------
# DEBUG=false
# RELOAD=false

# =============================================================================
# NOTES
# =============================================================================
#
# 1. Neo4j Configuration:
#    - Default credentials are neo4j/simorgh_secure_2024
#    - Change NEO4J_PASSWORD for production
#    - Access Neo4j Browser at http://192.168.1.68:7474
#
# 2. Redis Configuration:
#    - DB 0: User sessions & profiles
#    - DB 1: Chat history
#    - DB 2: LLM response caching
#    - DB 3: Authorization caching
#
# 3. SQL Server Authentication (Legacy TPMS):
#    - Used for legacy TPMS username/password login
#    - Validates project access permissions
#    - Results are cached in Redis
#
# 4. PostgreSQL Authentication (Modern):
#    - Primary auth database for email/password users
#    - Supports email verification, password reset
#    - Google OAuth user data stored here
#    - Run migrations: docker-compose exec postgres_auth psql -U simorgh -d simorgh_auth -f /migrations/001_create_auth_tables.sql
#
# 5. LLM Modes:
#    - online: Uses OpenAI API (requires OPENAI_API_KEY)
#    - offline: Uses local LLM servers (192.168.1.61, 192.168.1.62)
#    - auto: Tries online first, falls back to offline on failure
#
# 6. Local LLM Servers:
#    - Primary: 192.168.1.61
#    - Fallback: 192.168.1.62
#    - Both servers should expose /ai/chat endpoint
#
# 7. CocoIndex:
#    - Used for document processing and entity extraction
#    - Flows should be placed in ./cocoindex_flows/
#
# 8. Google OAuth Setup:
#    - Go to https://console.cloud.google.com/apis/credentials
#    - Create OAuth 2.0 credentials (Web application)
#    - Add Authorized JavaScript origins:
#      * https://simorghai.electrokavir.com
#    - Add Authorized redirect URIs:
#      * https://simorghai.electrokavir.com/chatbot/auth/google/callback
#    - Copy Client ID and Client Secret to .env
#    - Set the same Client ID in VITE_GOOGLE_CLIENT_ID for frontend
#
# 9. Email Service Setup (Gmail SMTP):
#    a. Enable 2-Factor Authentication on your Google account
#    b. Go to https://myaccount.google.com/apppasswords
#    c. Generate an App Password for "Mail"
#    d. Set SMTP_USER=your-email@gmail.com
#    e. Set SMTP_PASSWORD=the-16-char-app-password
#    - Required for: email verification, password reset, welcome emails
#
# 10. Security (IMPORTANT for production):
#    - Change all default passwords for production
#    - Generate strong JWT_SECRET_KEY: python3 -c "import secrets; print(secrets.token_hex(32))"
#    - Set SECURE_COOKIES=true (already default since TLS is enabled)
#    - Set COOKIE_DOMAIN=.electrokavir.com
#    - Use environment-specific .env files
#    - Never commit .env to version control
#
# 11. Authentication Routes:
#    - Modern login: /login (email + Google OAuth)
#    - Legacy login: /login/legacy (TPMS username)
#    - Signup: /signup
#    - Password reset: /forgot-password, /reset-password
#    - Email verification: /verify-email, /verify-email-sent
#
# =============================================================================

# =============================================================================
# 2026-05 ENTERPRISE MIGRATION — new services
# =============================================================================

# -----------------------------------------------------------------------------
# GITLAB CE (replaces techserver SMB + tech-knowledge clone)
# -----------------------------------------------------------------------------
GITLAB_VERSION=17.5.1-ce.0
GITLAB_HOSTNAME=gitlab.simorgh.local
GITLAB_SSH_PORT=2222
GITLAB_ROOT_PASSWORD=change-me-in-production
GITLAB_INTERNAL_URL=http://gitlab
# Generate via: GitLab UI → User Settings → Access Tokens (api scope).
GITLAB_API_TOKEN=glpat-XXXX
GITLAB_PROJECTS_GROUP=simorgh-projects
GITLAB_TECH_KB_REPO=simorgh-knowledge/technical-knowledge
GITLAB_DEFAULT_REF=main
GITLAB_MCP_URL=http://gitlab-mcp:8047

# -----------------------------------------------------------------------------
# RUNTIME-BROKER (replaces shell-service)
# -----------------------------------------------------------------------------
RUNTIME_BROKER_URL=http://runtime-broker:8048
BROKER_TOKEN=change-me-strong-random
BROKER_NETWORK=none
BROKER_PYTHON_IMAGE=python:3.12-slim
BROKER_NODE_IMAGE=node:20-alpine
BROKER_SHELL_IMAGE=ubuntu:22.04
BROKER_DEFAULT_TIMEOUT=30
BROKER_MAX_TIMEOUT=300
BROKER_MEM_LIMIT=512m
BROKER_CPU_QUOTA=50000
BROKER_PIDS_LIMIT=128
BROKER_TMPFS_SIZE=128m

# -----------------------------------------------------------------------------
# ELK STACK (logs + hybrid search)
# -----------------------------------------------------------------------------
# ELK images live on docker.elastic.co (NOT Docker Hub) — daemon.json
# registry-mirrors does NOT cover them. Set this to your Nexus
# elastic-proxy host. Example: 192.168.1.64:5000 (matches the
# `192.168.1.64:5000/elasticsearch/elasticsearch:8.15.3` images already
# loaded on the .68 host). Set to "docker.elastic.co" to bypass Nexus.
ELASTIC_REGISTRY=192.168.1.64:5000
ELASTIC_VERSION=8.15.3
ELASTIC_HEAP=1g
ELASTIC_SECURITY_ENABLED=false
ELASTIC_PASSWORD=change-me
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTIC_USER=elastic
LOGSTASH_HEAP=512m
LOGSTASH_HOST=logstash
LOGSTASH_PORT=5045
KIBANA_PUBLIC_URL=http://kibana.simorgh.local

# -----------------------------------------------------------------------------
# CONTEXT-SEARCH (hybrid BM25 + kNN over ES)
# -----------------------------------------------------------------------------
CONTEXT_SEARCH_URL=http://context-search:8049
EMBEDDINGS_URL=http://embeddings:8037
EMBED_DIMS=768

# -----------------------------------------------------------------------------
# TPMS-CONTEXT-AGENT
# -----------------------------------------------------------------------------
TPMS_CONTEXT_URL=http://tpms-context-agent:8050
TPMS_CONTEXT_TTL_SEC=300

# -----------------------------------------------------------------------------
# MAILCOW + MAIL-BRIDGE (replaces mail-gateway + project-mail)
# -----------------------------------------------------------------------------
# These resolve to mailcow's containers once you join them to simorgh_app_net.
IMAP_HOST=dovecot-mailcow
IMAP_PORT=143
IMAP_USE_STARTTLS=true
SMTP_HOST=postfix-mailcow
SMTP_PORT=587
SMTP_USE_STARTTLS=true
MAILBOX_USER=simorghai@electrokavir.com
MAILBOX_PASSWORD=change-me
MAILBOX_FOLDER=INBOX
MAIL_WEBHOOK_URL=http://backend:8890/api/v2/agent/email-webhook
MAIL_WEBHOOK_TOKEN=

# -----------------------------------------------------------------------------
# AGENT-WIDE TOKEN (used for write access to gitlab-mcp, etc.)
# -----------------------------------------------------------------------------
AGENT_TOKEN=change-me-strong-random

# =============================================================================
# OFFICE-SCALE TUNING & WEB UI PORTS
# =============================================================================
# Reference target: ~50–200 concurrent users, single host on .68 with
# 32 GB RAM and 8 vCPU. Adjust _MEM_LIMIT / _WORKERS / _HEAP per host
# capacity. All knobs have safe defaults — overrides go here.

# -----------------------------------------------------------------------------
# GITLAB CE — web UI on http://<host>:${GITLAB_HTTP_PORT}
# -----------------------------------------------------------------------------
GITLAB_HTTP_PORT=8929
GITLAB_SSH_PORT=2222
GITLAB_EXTERNAL_URL=http://gitlab.simorgh.local:8929

# Heaviness tuning (omnibus → puma + sidekiq + bundled pg/redis)
GITLAB_PUMA_WORKERS=4              # ≈ vCPU; each ~1.2 GB
GITLAB_PUMA_MIN_THREADS=4
GITLAB_PUMA_MAX_THREADS=8
GITLAB_SIDEKIQ_CONCURRENCY=25
GITLAB_PG_SHARED_BUFFERS=1GB
GITLAB_PG_MAX_CONNECTIONS=300
GITLAB_PG_EFFECTIVE_CACHE=3GB
GITLAB_PG_WORK_MEM=16MB
GITLAB_PG_MAINT_WORK_MEM=256MB
GITLAB_REDIS_MAXMEMORY=1gb
GITLAB_GITALY_CONCURRENCY=32
GITLAB_BACKUP_KEEP_TIME=604800     # 7 days

GITLAB_MEM_LIMIT=12g
GITLAB_MEM_RESERVATION=6g
GITLAB_SHM_SIZE=512m

# Outbound notifications (routed through mail-bridge → Mailcow)
GITLAB_SMTP_DOMAIN=simorgh.local
GITLAB_EMAIL_FROM=gitlab@simorgh.local

# -----------------------------------------------------------------------------
# ELASTICSEARCH / LOGSTASH / KIBANA / FILEBEAT
# -----------------------------------------------------------------------------
# Web UIs:
#   Kibana:        http://<host>:${KIBANA_HTTP_PORT}
#   Elasticsearch: http://<host>:${ELASTIC_HTTP_PORT}      (admin/debug)
KIBANA_HTTP_PORT=5601
ELASTIC_HTTP_PORT=9200

ELASTIC_HEAP=4g
ELASTIC_MEM_LIMIT=6g
ELASTIC_MEM_RESERVATION=4g
ELASTIC_INDEX_BUFFER=15%
ELASTIC_MAX_BUCKETS=65536
ELASTIC_WRITE_QUEUE=1000
ELASTIC_SEARCH_QUEUE=2000

LOGSTASH_HEAP=1g
LOGSTASH_MEM_LIMIT=1500m
LOGSTASH_MEM_RESERVATION=1g
LOGSTASH_PIPELINE_WORKERS=4
LOGSTASH_PIPELINE_BATCH=500

KIBANA_NODE_HEAP_MB=1500
KIBANA_MEM_LIMIT=2g
KIBANA_MEM_RESERVATION=1g

FILEBEAT_MEM_LIMIT=300m

# -----------------------------------------------------------------------------
# POSTGRES (auth) — optional host exposure on ${POSTGRES_AUTH_HTTP_PORT}
# -----------------------------------------------------------------------------
POSTGRES_AUTH_HTTP_PORT=5433
POSTGRES_AUTH_MAX_CONNECTIONS=300
POSTGRES_AUTH_SHARED_BUFFERS=1GB
POSTGRES_AUTH_EFFECTIVE_CACHE=3GB
POSTGRES_AUTH_WORK_MEM=16MB
POSTGRES_AUTH_MAINT_WORK_MEM=256MB
POSTGRES_AUTH_MAX_WORKERS=8
POSTGRES_AUTH_MAX_PARALLEL=8
POSTGRES_AUTH_MEM_LIMIT=3g
POSTGRES_AUTH_MEM_RESERVATION=1g
POSTGRES_AUTH_SHM_SIZE=256m

# -----------------------------------------------------------------------------
# REDIS — optional host exposure on ${REDIS_HTTP_PORT}
# -----------------------------------------------------------------------------
REDIS_HTTP_PORT=6380
REDIS_MAXMEMORY=2gb
REDIS_MAXMEMORY_POLICY=allkeys-lru
REDIS_IO_THREADS=4
REDIS_MEM_LIMIT=2500m
REDIS_MEM_RESERVATION=1g

# -----------------------------------------------------------------------------
# QDRANT — web dashboard at http://<host>:${QDRANT_HTTP_PORT}/dashboard
# -----------------------------------------------------------------------------
QDRANT_HTTP_PORT=6333
QDRANT_MAX_REQUEST_MB=64
QDRANT_MAX_WORKERS=0          # 0 = auto (one per CPU)
QDRANT_MAX_SEARCH_THREADS=0
QDRANT_INDEX_THRESHOLD=20000
QDRANT_LOG_LEVEL=INFO
QDRANT_MEM_LIMIT=3g
QDRANT_MEM_RESERVATION=1g

# -----------------------------------------------------------------------------
# RUNTIME-BROKER + GITLAB-MCP + CONTEXT-SEARCH (worker counts + host ports)
# -----------------------------------------------------------------------------
BROKER_WORKERS=4
BROKER_MAX_CONCURRENT=32
BROKER_MEM_LIMIT_BROKER=1g
BROKER_MEM_LIMIT=1g           # per spawned task container
BROKER_CPU_QUOTA=100000       # 1 full CPU per task
BROKER_PIDS_LIMIT=256
BROKER_TMPFS_SIZE=256m

GITLAB_MCP_WORKERS=4
GITLAB_MCP_HTTP_PORT=8047
GITLAB_MCP_MEM_LIMIT=512m

CONTEXT_SEARCH_WORKERS=4
CONTEXT_SEARCH_HTTP_PORT=8049
CONTEXT_SEARCH_MEM_LIMIT=1g

# -----------------------------------------------------------------------------
# EPLAN-BRIDGE (simorgh-soft "Send to EPLAN") — see eplan-bridge-service/app.py
# and eplan-port-forwarder/README.md for the whole path this takes.
# -----------------------------------------------------------------------------
# The machine EPLAN runs on — 192.168.1.64 here, the Windows box with EPLAN,
# the Eplanix add-in and Docker Desktop on it.
#
# Do NOT confuse this with SQL_SERVER (192.168.1.39), which is the Eplan_n2
# database and has no EPLAN process on it at all. They are different machines
# and pointing this at the database one is silent: the bridge simply scans a
# port range nothing answers on, and every send reports that no EPLAN is
# available.
#
# Note also what has to be running at this address for it to answer. The
# AsyncTcpServer that actually receives a drawing binds 127.0.0.1 only, so
# nothing reaches it from another machine until something on that box
# forwards the pool from its real interface to its own loopback — either
# eplan-port-forwarder (see eplan-port-forwarder/) or the netsh portproxy
# rules its README describes. This address is that forwarder's; in the normal
# case the forwarder runs on the EPLAN machine, so the two are the same.
EPLAN_HOST=192.168.1.64
# Keep identical to eplan-port-forwarder's own PORT_MIN/PORT_MAX (its
# defaults already match these) and to Eplanix's own TcpPortResolverService
# pool, so the ranges being scanned line up on every hop.
EPLAN_PORT_MIN=12000
EPLAN_PORT_MAX=12100
# Set once /draw is reachable from outside this compose network (which it now
# is, from simorgh-soft's backend) — leave empty only while eplan-bridge is
# still compose-internal-only.
EPLAN_BRIDGE_API_KEY=
EPLAN_TCP_TIMEOUT=120

# ---- Downloading what EPLAN produced (eplan-files) --------------------------
# The drawings land on the techserver SMB share, so this service reuses the
# TECHSERVER_* credentials set further up — there is one techserver account for
# the stack, not one per service.
#
# Ceiling on a project archive, and how long simorgh-soft waits for one. An
# EPLAN project is the .elk plus its whole .edb directory, fetched over SMB and
# then zipped, so both are generous by design.
EPLAN_ZIP_MAX_BYTES=1073741824
EPLAN_DOWNLOAD_TIMEOUT_MS=900000
# Optional shared secret between simorgh-soft and eplan-files. Both sides read
# the same variable; empty means no auth, which is fine while this only takes
# traffic from inside the compose network.
EPLAN_FILES_API_KEY=

# =============================================================================
# PACKAGE REGISTRIES (build-time only)
# =============================================================================
# Read by the Dockerfiles as build-args, so they matter only when something is
# built here — with the default stack pulling finished images, nothing below is
# used at all.
#
# The comment here used to say "leave these as-is to pull from public
# registries" while the values pointed at a Nexus on 192.168.1.64:8081 that no
# longer runs. Anyone who copied this file got a build that died on
# `ECONNREFUSED 192.168.1.64:8081` several minutes in. The values now match
# what the comment always claimed.
PIP_INDEX_URL=https://pypi.org/simple/
PIP_TRUSTED_HOST=
NPM_REGISTRY=https://registry.npmjs.org/
# An internal mirror, if one is ever stood up again. Point them at it and keep
# PIP_TRUSTED_HOST set for a plain-HTTP one, or pip refuses it.
#PIP_INDEX_URL=http://<mirror>:8081/repository/pypi-proxy/simple/
#PIP_TRUSTED_HOST=<mirror>
#NPM_REGISTRY=http://<mirror>:8081/repository/npm-proxy/
