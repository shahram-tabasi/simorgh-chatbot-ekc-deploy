VITE_API_URL=http://localhost:3001

# ── EPLAN drawing server ──────────────────────────────────────────────────
# Where "Send to EPLAN" on the Eplanix tab posts. Left EMPTY on purpose: the
# address is then read from the server at runtime, out of the backend's own
# environment (EPLAN_API_HOST / EPLAN_API_PORT — set in simorgh-backend/.env,
# or for the deployed stack in simorgh-agent/.env, which compose passes in).
# Changing it there is an edit and a restart; these two would need a rebuild,
# because Vite bakes them into the bundle. Fill them in only to pin a
# different server for a locally built bundle.
VITE_EPLAN_API_HOST=
VITE_EPLAN_API_PORT=
