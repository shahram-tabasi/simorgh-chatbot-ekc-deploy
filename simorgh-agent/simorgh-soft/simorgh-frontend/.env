VITE_API_URL=http://localhost:3001

# ── EPLAN drawing server ──────────────────────────────────────────────────
# Where "Send to EPLAN" on the Eplanix tab posts: the IP of the EPLAN machine
# and the port it listens on. Edit these two lines to point at another server.
# They prefill the Target fields in the send dialog, and the dialog also lets
# them be changed for a single send without touching this file.
# Leave them empty to use whatever the backend's own .env
# (EPLAN_API_HOST / EPLAN_API_PORT) is set to.
VITE_EPLAN_API_HOST=192.168.1.39
VITE_EPLAN_API_PORT=8000
