{
  "name": "simorgh-design-suite-desktop",
  "productName": "Simorgh Design Suite",
  "version": "1.1.0",
  "description": "Windows desktop client for Simorgh Design Suite",
  "author": "شرکت سیمرغ فناوری هوشمند ایرانیان",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "ir.simorghfanavari.designsuite",
    "publish": null,
    "productName": "Simorgh Design Suite",
    "copyright": "© Simorgh Smart Technology of Iranians Co.",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "server.json",
      "build/icon.png",
      "build/icon.ico",
      "welcome.html",
      "welcome-art.jpg"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "SimorghDesignSuite-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Simorgh Design Suite",
      "license": "build/license.txt",
      "include": "build/installer.nsh",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true
    }
  }
}
