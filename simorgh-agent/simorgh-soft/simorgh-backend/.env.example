# Simorgh backend — sample environment configuration
# Copy to `.env` and fill in the values for your deployment.

# ── Server ────────────────────────────────────────────────────────────────
PORT=3001

# ── MongoDB (required) ────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=simorgh_db

# ── SQL Server (EPLAN parts) — optional ───────────────────────────────────
SQL_USER=userfanni
SQL_PASSWORD=12345678
SQL_SERVER=192.168.1.39
SQL_DATABASE=Eplan_n2
SQL_PORT=1433

# ── MySQL (TPMS) — optional ───────────────────────────────────────────────
# MYSQL_HOST=...
# MYSQL_USER=...
# MYSQL_PASSWORD=...
# MYSQL_DATABASE=...

# ─────────────────────────────────────────────────────────────────────────
# AI CHATBOT — LOCAL (offline) model = gpt-oss-20b on 192.168.1.61
# ─────────────────────────────────────────────────────────────────────────
# Deployed local stack (see llms/README.md):
#   192.168.1.61 → gpt-oss-20b (Unsloth+vLLM+FastAPI), OpenAI-compatible :80
#
# The backend defaults to the bespoke `/generate` endpoint on the .61 box
# rather than `/v1/chat/completions`, because the latter auto-routes to a
# LangChain Wikipedia/search agent whenever the project context contains
# keywords like "iec", "current", "siemens", etc. — which our snapshots
# always do. /generate accepts use_tools=false explicitly and produces the
# raw JSON envelope the frontend expects.
#
# Defaults used when no env override is set:
#   AI_SERVICE_URL   = http://192.168.1.61    (talks to /generate)
#   LOCAL_MODEL_NAME = gpt-oss-20b
#
# Note: the .61 nginx IP-allowlists 192.168.1.68 + localhost. If this
# backend runs elsewhere, either move it to .68 or extend the allowlist
# in llms/nginx_configs/conf.d/llm.conf on the .61 host.

# Uncomment to override the defaults:
# AI_SERVICE_URL=http://192.168.1.61
# LOCAL_MODEL_NAME=gpt-oss-20b
# LOCAL_MODEL_KEY=
# LOCAL_MODEL_MAX_TOKENS=4096
# LOCAL_MODEL_REASONING=low      # low | medium | high

# ─── Optional: skip /generate and use a raw OpenAI-compatible chat URL ────
# For LM Studio / vLLM / external OpenAI-style endpoints. Note: hitting
# .61's /v1/chat/completions directly re-enables the LangChain agent path.
# LOCAL_MODEL_URL=http://127.0.0.1:8080/v1/chat/completions

# ─── Optional: route through llm-gateway instead of hitting .61 directly ──
# Preferred when running inside the simorgh-agent stack on .68 — the
# gateway already handles online↔offline fallback, strips <think> tags,
# and tracks per-user concurrency.
#
# LLM_GATEWAY_URL=http://llm-gateway:8030        # in docker network
# LLM_GATEWAY_URL=http://192.168.1.68/api/llm-gateway   # via host nginx
# LLM_GATEWAY_MODE=offline                       # offline | online | auto

# ─────────────────────────────────────────────────────────────────────────
# AI CHATBOT — ONLINE model (optional)
# ─────────────────────────────────────────────────────────────────────────
# Any OpenAI-compatible API (OpenAI, OpenRouter, Together, Groq, …).
# Same JSON tool-call protocol as the local endpoint.

# ONLINE_MODEL_URL=https://api.openai.com/v1/chat/completions
# ONLINE_MODEL_KEY=sk-...
# ONLINE_MODEL_NAME=gpt-4o-mini
