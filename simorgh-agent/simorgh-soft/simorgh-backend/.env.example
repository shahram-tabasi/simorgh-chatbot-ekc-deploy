# Simorgh backend — sample environment configuration
# Copy to `.env` and fill in the values for your deployment.

# ── Server ────────────────────────────────────────────────────────────────
PORT=3001

# ── MongoDB (required) ────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=simorgh_db

# The office's library — symbols, and whatever else outlives a job — in its own
# database on the same server. Separate from the projects on purpose: the
# library belongs to the office rather than to any job, and can be dumped,
# restored or carried to another site by itself. `mongodump --uri --archive`
# takes every database, so the nightly backup already includes it.
LIBRARY_DATABASE_NAME=simorgh_library

# ── SQL Server (EPLAN parts) — optional ───────────────────────────────────
SQL_USER=userfanni
SQL_PASSWORD=12345678
SQL_SERVER=192.168.1.39
SQL_DATABASE=Eplan_n2
SQL_PORT=1433

# ── MySQL (TPMS) — optional ───────────────────────────────────────────────
# MYSQL_HOST=...
# MYSQL_USER=...
# MYSQL_PASSWORD=...
# MYSQL_DATABASE=...
#
# How long a TPMS query may run before the request gives up. mysql2 cannot
# cancel the statement server-side, so the socket is dropped when this fires.
# TPMS_QUERY_TIMEOUT_MS=60000
#
# How long a liveness check (ping) on a pooled TPMS connection may take before
# the socket is treated as dead and replaced. Keep it small: the whole point is
# to notice a dropped connection in milliseconds instead of waiting out
# TPMS_QUERY_TIMEOUT_MS above.
# MYSQL_PING_TIMEOUT_MS=5000

# ─────────────────────────────────────────────────────────────────────────
# AI CHATBOT — LOCAL (offline) model
# ─────────────────────────────────────────────────────────────────────────
# The assistant runs on the VLM (Qwen2.5-VL), served OpenAI-compatibly on
# 192.168.1.61. It is instruction-tuned and honours
# `response_format: json_object`, which is what the tool-call contract needs:
# a reasoning model narrates its thinking instead of answering in JSON, and
# the app is left with nothing to execute.
#
# Defaults when no override is set:
#   LOCAL_MODEL_URL  = http://192.168.1.61/v1/chat/completions
#   LOCAL_MODEL_NAME = qwen2.5-vl-7b
#
# compose/soft-app.yml passes both through, so for the deployed stack these
# are set in simorgh-agent/.env and picked up by a restart — no rebuild.
#
# Note: both .61 and .62 IP-allowlist 192.168.1.68 + localhost in their
# nginx config. If this backend runs elsewhere, either move it to .68 or
# extend the allowlist in llms/nginx_configs/conf.d/*.conf on the LLM
# host.

# Uncomment to override the defaults:
# LOCAL_MODEL_URL=http://192.168.1.61/v1/chat/completions
# LOCAL_MODEL_NAME=qwen2.5-vl-7b
# LOCAL_MODEL_KEY=
# LOCAL_MODEL_MAX_TOKENS=4096

# ─── Use a bespoke /generate service instead (opt-in, not recommended) ───
# A reasoning model reached through /generate mostly refuses the JSON
# envelope, so the assistant can answer but cannot act.
# AI_SERVICE_URL=http://192.168.1.61    # talks to /generate, use_tools=false
# LOCAL_MODEL_NAME=gpt-oss-20b
# LOCAL_MODEL_REASONING=low             # low | medium | high

# ─── Or another OpenAI-compatible local server (LM Studio, llama.cpp …) ──
# LOCAL_MODEL_URL=http://127.0.0.1:8080/v1/chat/completions

# ─── Optional: route through llm-gateway instead of hitting .61 directly ──
# Preferred when running inside the simorgh-agent stack on .68 — the
# gateway already handles online↔offline fallback, strips <think> tags,
# and tracks per-user concurrency.
#
# LLM_GATEWAY_URL=http://llm-gateway:8030        # in docker network
# LLM_GATEWAY_URL=http://192.168.1.68/api/llm-gateway   # via host nginx
# LLM_GATEWAY_MODE=offline                       # offline | online | auto

# ─────────────────────────────────────────────────────────────────────────
# AI CHATBOT — ONLINE model (optional)
# ─────────────────────────────────────────────────────────────────────────
# Any OpenAI-compatible API (OpenAI, OpenRouter, Together, Groq, …).
# Same JSON tool-call protocol as the local endpoint.

# ONLINE_MODEL_URL=https://api.openai.com/v1/chat/completions
# ONLINE_MODEL_KEY=sk-...
# ONLINE_MODEL_NAME=gpt-4o-mini

# ── EPLAN bridge (Eplanix → "Send to EPLAN") ──────────────────────────────
# eplan-bridge-service (see simorgh-agent/eplan-bridge-service) is what
# actually holds the TCP connection to EPLAN's listener and picks a port
# from the pool — this backend only forwards records to it over HTTP. The
# default below is the compose service name, and works as-is when this
# backend runs in the same stack; set it to a reachable URL otherwise.
EPLAN_BRIDGE_URL=http://eplan-bridge:8026
# Only needed if the bridge was deployed with EPLAN_BRIDGE_API_KEY set.
EPLAN_BRIDGE_API_KEY=
# How long to wait for the drawing job to answer (ms).
EPLAN_BRIDGE_TIMEOUT_MS=120000
