# Simorgh backend — sample environment configuration
# Copy to `.env` and fill in the values for your deployment.

# ── Server ────────────────────────────────────────────────────────────────
PORT=3001

# ── MongoDB (required) ────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=simorgh_db

# ── SQL Server (EPLAN parts) — optional ───────────────────────────────────
SQL_USER=userfanni
SQL_PASSWORD=12345678
SQL_SERVER=192.168.1.39
SQL_DATABASE=Eplan_n2
SQL_PORT=1433

# ── MySQL (TPMS) — optional ───────────────────────────────────────────────
# MYSQL_HOST=...
# MYSQL_USER=...
# MYSQL_PASSWORD=...
# MYSQL_DATABASE=...

# ─────────────────────────────────────────────────────────────────────────
# AI CHATBOT — LOCAL (offline) model
# ─────────────────────────────────────────────────────────────────────────
# Deployed local stack (see llms/README.md):
#   192.168.1.61 → gpt-oss-20b   (reasoning model, Unsloth+vLLM+FastAPI)
#   192.168.1.62 → Qwen2.5-VL-7B (instruction-tuned, standard vllm-openai)
#
# DEFAULT: we point at .62 / Qwen because it actually follows the JSON
# tool-call contract. gpt-oss-20b on .61 is a reasoning model and ignores
# our "respond in JSON" instructions most of the time, returning prose
# (often even chain-of-thought) which the chatbot can't act on. .62 runs
# the upstream `vllm/vllm-openai` image and respects
# `response_format: json_object` for guided JSON decoding, which is what
# we actually need for an agent.
#
# Defaults when no override is set:
#   LOCAL_MODEL_URL  = http://192.168.1.62/v1/chat/completions
#   LOCAL_MODEL_NAME = qwen2.5-vl-7b
#
# Note: both .61 and .62 IP-allowlist 192.168.1.68 + localhost in their
# nginx config. If this backend runs elsewhere, either move it to .68 or
# extend the allowlist in llms/nginx_configs/conf.d/*.conf on the LLM
# host.

# Uncomment to override the defaults:
# LOCAL_MODEL_URL=http://192.168.1.62/v1/chat/completions
# LOCAL_MODEL_NAME=qwen2.5-vl-7b
# LOCAL_MODEL_KEY=
# LOCAL_MODEL_MAX_TOKENS=4096

# ─── Use the .61 reasoning model instead (opt-in, not recommended) ───────
# AI_SERVICE_URL=http://192.168.1.61    # talks to /generate, use_tools=false
# LOCAL_MODEL_NAME=gpt-oss-20b
# LOCAL_MODEL_REASONING=low             # low | medium | high

# ─── Or another OpenAI-compatible local server (LM Studio, llama.cpp …) ──
# LOCAL_MODEL_URL=http://127.0.0.1:8080/v1/chat/completions

# ─── Optional: route through llm-gateway instead of hitting .61 directly ──
# Preferred when running inside the simorgh-agent stack on .68 — the
# gateway already handles online↔offline fallback, strips <think> tags,
# and tracks per-user concurrency.
#
# LLM_GATEWAY_URL=http://llm-gateway:8030        # in docker network
# LLM_GATEWAY_URL=http://192.168.1.68/api/llm-gateway   # via host nginx
# LLM_GATEWAY_MODE=offline                       # offline | online | auto

# ─────────────────────────────────────────────────────────────────────────
# AI CHATBOT — ONLINE model (optional)
# ─────────────────────────────────────────────────────────────────────────
# Any OpenAI-compatible API (OpenAI, OpenRouter, Together, Groq, …).
# Same JSON tool-call protocol as the local endpoint.

# ONLINE_MODEL_URL=https://api.openai.com/v1/chat/completions
# ONLINE_MODEL_KEY=sk-...
# ONLINE_MODEL_NAME=gpt-4o-mini
