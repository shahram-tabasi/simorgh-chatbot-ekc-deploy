# Simorgh backend — sample environment configuration
# Copy to `.env` and fill in the values for your deployment.

# ── Server ────────────────────────────────────────────────────────────────
PORT=3001

# ── MongoDB (required) ────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=simorgh_db

# ── SQL Server (EPLAN parts) — optional ───────────────────────────────────
SQL_USER=userfanni
SQL_PASSWORD=12345678
SQL_SERVER=192.168.1.39
SQL_DATABASE=Eplan_n2
SQL_PORT=1433

# ── MySQL (TPMS) — optional ───────────────────────────────────────────────
# MYSQL_HOST=...
# MYSQL_USER=...
# MYSQL_PASSWORD=...
# MYSQL_DATABASE=...

# ─────────────────────────────────────────────────────────────────────────
# AI CHATBOT — LOCAL model
# ─────────────────────────────────────────────────────────────────────────
# The backend supports two transports out of the box:
#
# 1)  Ollama (default)
#     Just install & run Ollama, pull a model, and leave LOCAL_MODEL_URL empty.
#       $ ollama pull llama3.1          # or mistral, qwen2.5, phi3, …
#       $ ollama serve                  # listens on 127.0.0.1:11434
#     Then set:
#       OLLAMA_HOST=http://127.0.0.1:11434
#       LOCAL_MODEL_NAME=llama3.1
#
# 2)  Any OpenAI-compatible local server (llama.cpp --server, vLLM, LM Studio,
#     text-generation-webui --api, …). Set the FULL chat-completions URL:
#       LOCAL_MODEL_URL=http://127.0.0.1:8080/v1/chat/completions
#       LOCAL_MODEL_NAME=qwen2.5-7b-instruct
#       LOCAL_MODEL_KEY=optional-bearer-token

OLLAMA_HOST=http://127.0.0.1:11434
LOCAL_MODEL_NAME=llama3.1
# LOCAL_MODEL_URL=http://127.0.0.1:8080/v1/chat/completions
# LOCAL_MODEL_KEY=

# ─────────────────────────────────────────────────────────────────────────
# AI CHATBOT — ONLINE model (optional)
# ─────────────────────────────────────────────────────────────────────────
# Any OpenAI-compatible API (OpenAI, OpenRouter, Together, Groq, …). The
# backend POSTs `/v1/chat/completions` style requests and parses the JSON
# tool-call envelope from `choices[0].message.content`.

# ONLINE_MODEL_URL=https://api.openai.com/v1/chat/completions
# ONLINE_MODEL_KEY=sk-...
# ONLINE_MODEL_NAME=gpt-4o-mini
