# Docker Compose Environment Variables
# Copy this file to .env and configure for your environment

# ============================================================================
# Registry Configuration
# ============================================================================
GITHUB_REGISTRY=ghcr.io
GITHUB_REPOSITORY_OWNER=shahram-tabasi
IMAGE_TAG=latest

# ============================================================================
# Model Storage Configuration
# ============================================================================
# Path on host machine where models will be downloaded and cached
# This directory should have sufficient space (~40GB+ for both models)
MODEL_CACHE_PATH=/home/ubuntu/models

# ============================================================================
# Hugging Face Configuration
# ============================================================================
# HuggingFace API token (required for gated models)
# Get your token from: https://huggingface.co/settings/tokens
# Leave empty if model doesn't require authentication
HF_TOKEN=

# ============================================================================
# LangChain Tool Configuration
# ============================================================================
# Enable web search tool (uses DuckDuckGo by default)
ENABLE_SEARCH_TOOL=true

# Enable Python REPL tool (SECURITY WARNING: allows code execution)
# Only enable in trusted environments with proper sandboxing
ENABLE_PYTHON_REPL=false

# Enable Siemens Product Information Hub tool
# Requires SIEMENS_CLIENT_ID and SIEMENS_CLIENT_SECRET from
# https://developer.siemens.com (Xcelerator Developer Portal)
ENABLE_SIEMENS_API=false

# Enable verbose logging for agent reasoning steps
AGENT_VERBOSE=false

# ============================================================================
# Self-Hosted Search API (Optional)
# ============================================================================
# If you have a self-hosted search API (e.g., serpapi-bing)
# Leave empty to use DuckDuckGo
SEARCH_API_URL=
SEARCH_API_KEY=

# ============================================================================
# Python REPL Configuration (if enabled)
# ============================================================================
# Timeout for Python code execution (seconds)
PYTHON_REPL_TIMEOUT=10

# Use subprocess sandboxing (recommended)
PYTHON_REPL_SANDBOX=true

# ============================================================================
# Siemens Developer API Configuration (if enabled)
# ============================================================================
# Get an API key from Siemens Xcelerator:
# https://xcelerator.siemens.com/global/en/all-offerings/apis/p/product-information-hub.html
# Click "Get sandbox access" or "Explore subscription options"
SIEMENS_API_KEY=

# ============================================================================
# Model Configuration  (Qwen3-30B-A3B-Instruct-2507, 4-bit AWQ)
# ============================================================================
# Directory name (under MODEL_CACHE_PATH, mounted at /models) holding the
# AWQ weights. Used by docker-compose.llm.yml's --model arg.
# HF repo: cyankiwi/Qwen3-30B-A3B-Instruct-2507-AWQ-4bit
VLLM_MODEL_DIR=Qwen3-30B-A3B-Instruct-2507-AWQ-4bit
# Name vLLM advertises + the gateway calls. Match LOCAL_LLM_MODEL_TEXT
# in the simorgh-agent .env.
LOCAL_LLM_MODEL_TEXT=qwen3-30b-a3b
# vLLM serving knobs.
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_UTIL=0.92

# ============================================================================
# Directory Structure
# ============================================================================
# The MODEL_CACHE_PATH will contain:
# - huggingface/                              (HF cache: tokenizer metadata)
# - Qwen3-30B-A3B-Instruct-2507-AWQ-4bit/    (AWQ weights for vLLM)
#
# Example layout:
# /home/ubuntu/models/
# ├── huggingface/
# └── Qwen3-30B-A3B-Instruct-2507-AWQ-4bit/
#     ├── config.json          (has quantization_config: awq)
#     ├── model-00001-of-*.safetensors
#     └── ...
#
# Download once (over the slow link) on any box with HF access, then
# rsync the directory to .61's MODEL_CACHE_PATH:
#   huggingface-cli download cyankiwi/Qwen3-30B-A3B-Instruct-2507-AWQ-4bit \
#     --local-dir /home/ubuntu/models/Qwen3-30B-A3B-Instruct-2507-AWQ-4bit
