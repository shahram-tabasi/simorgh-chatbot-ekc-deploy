```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map

# Environment variables
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Logs
*.log

# Python (if applicable)
__pycache__/
*.pyc
*.pyo
*.pyd

# Coverage reports
coverage/
htmlcov/
*.coverage

# Temporary files
*.tmp
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Compiled files
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out
*.class

# Package managers
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
.nyc_output/
coverage/

# Distribution / packaging
.Python
*.egg-info/
.eggs/

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# PyTest
.pytest_cache/

# Gradle
.gradle/
build/

# Maven
target/

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```